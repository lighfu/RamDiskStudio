<Window x:Class="RamDisk.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:RamDisk.App"
        Style="{StaticResource {x:Type Window}}" Title="RAM Disk Studio" Width="1160" Height="820" MinWidth="1100" MinHeight="800" WindowStartupLocation="CenterScreen" Closing="Window_Closing">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="204"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border x:Name="Sidebar" Background="{DynamicResource SidebarBackground}">
      <Grid Margin="22,32,22,24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
          <Border Background="{DynamicResource LogoBackground}" Width="44" Height="44" CornerRadius="12" HorizontalAlignment="Left" Margin="0,0,0,18">
            <TextBlock Text="&#xE950;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource LogoText}" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="RAM Disk" Foreground="{DynamicResource SidebarTitle}" FontSize="25" FontWeight="SemiBold"/>
          <TextBlock Text="STUDIO" Foreground="{DynamicResource LogoSubtitle}" FontSize="12" Margin="2,5,0,36"/>
          <Button x:Name="DisksNav" Content="▣  ディスク" Background="{DynamicResource SidebarSelected}" Foreground="{DynamicResource SidebarTitle}" BorderThickness="0" Click="Disks_Click"/>
          <Button x:Name="MonitorNav" Content="▥  モニター" Background="Transparent" Foreground="{DynamicResource SidebarText}" BorderThickness="0" Margin="0,8,0,0" Click="Monitor_Click"/>
          <Button Content="使い方・仕様" Click="Help_Click" Background="Transparent" Foreground="{DynamicResource SidebarText}" BorderThickness="0" HorizontalContentAlignment="Left" Margin="0,9,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="2">
          <Button x:Name="ThemeButton" Content="{Binding ToggleLabel, Source={x:Static local:ThemeManager.Current}}" Click="Theme_Click" Margin="0,0,0,14" ToolTip="ライト / ダークを切り替える（次回起動時にも保持）"/>
          <Border BorderBrush="{DynamicResource SidebarLine}" BorderThickness="0,1,0,0" Padding="0,18,0,0">
            <StackPanel><TextBlock Text="WINDOWS / x64" Foreground="{DynamicResource SidebarMuted}" FontSize="11"/><TextBlock Text="RAM Disk Studio  0.3.1" Foreground="{DynamicResource SidebarText}" FontSize="12" Margin="0,7,0,0"/></StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </Border>
    <Grid x:Name="DisksPage" Grid.Column="1" Margin="32,28,32,22">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Grid Margin="0,0,0,24">
        <StackPanel><TextBlock Text="メモリを、ワークスペースに。" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="一時ファイルのための RAM ドライブを管理します。" Foreground="{DynamicResource Muted}" Margin="0,7,0,0"/></StackPanel>
        <Button x:Name="AddButton" Content="＋  ディスクを追加" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Add_Click"/>
      </Grid>
      <Grid Grid.Row="1" Margin="0,0,0,18">
        <Grid.ColumnDefinitions><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}"><StackPanel>
          <TextBlock Text="システムの空きメモリ" Style="{StaticResource Caption}"/>
          <TextBlock x:Name="MemoryAvailableText" Text="— GiB" FontSize="29" FontWeight="SemiBold" Margin="0,6,0,9"/>
          <ProgressBar x:Name="MemoryBar" Height="5" Foreground="{DynamicResource Accent}" Background="{DynamicResource SurfaceRaised}" BorderThickness="0" Maximum="100"/>
          <TextBlock x:Name="MemoryDetailText" Style="{StaticResource Caption}" Margin="0,8,0,0" Text="メモリを確認中"/>
        </StackPanel></Border>
        <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="稼働中のディスク" Style="{StaticResource Caption}"/><TextBlock x:Name="MountedCountText" Text="0" FontSize="29" FontWeight="SemiBold" Margin="0,6,0,10"/><TextBlock x:Name="ProfileCountText" Text="保存済み設定  0 件" Style="{StaticResource Caption}"/></StackPanel></Border>
        <Border Grid.Column="4" Style="{StaticResource Card}"><StackPanel><TextBlock Text="RAM ディスクの容量" Style="{StaticResource Caption}"/><TextBlock x:Name="AllocatedText" Text="0 GiB" FontSize="29" FontWeight="SemiBold" Margin="0,6,0,10"/><TextBlock Text="このアプリの稼働分" Style="{StaticResource Caption}"/></StackPanel></Border>
      </Grid>
      <Border x:Name="SetupBanner" Grid.Row="2" Background="{DynamicResource InfoBackground}" BorderBrush="{DynamicResource InfoBorder}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,18">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center" Margin="0,0,12,0"><TextBlock x:Name="SetupTitle" FontWeight="SemiBold"/><TextBlock x:Name="SetupDescription" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,3,0,0" TextWrapping="Wrap"/></StackPanel>
          <Button Grid.Column="1" x:Name="DriverButton" Content="ドライバーの入手" Click="Driver_Click" FontSize="12" Padding="12,8" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <Button Grid.Column="2" x:Name="AdminButton" Content="管理者として再起動" Click="Admin_Click" FontSize="12" Padding="12,8" VerticalAlignment="Center"/>
        </Grid>
      </Border>
      <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid Margin="20,17"><TextBlock Text="ディスク一覧" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/><Button x:Name="RefreshButton" Content="↻  更新" Click="Refresh_Click" HorizontalAlignment="Right" Padding="11,5" FontSize="12"/></Grid>
          <Grid Grid.Row="1" Background="{DynamicResource SurfaceRaised}" Height="34">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
            <TextBlock Text="ドライブ / 名前" Margin="20,0,0,0" VerticalAlignment="Center" Style="{StaticResource Caption}"/>
            <TextBlock Grid.Column="1" Text="容量" VerticalAlignment="Center" Style="{StaticResource Caption}"/>
            <TextBlock Grid.Column="2" Text="形式" VerticalAlignment="Center" Style="{StaticResource Caption}"/>
            <TextBlock Grid.Column="3" Text="メモリ方式" VerticalAlignment="Center" Style="{StaticResource Caption}"/>
            <TextBlock Grid.Column="4" Text="状態" VerticalAlignment="Center" Style="{StaticResource Caption}"/>
          </Grid>
          <ListBox x:Name="DiskList" Grid.Row="2" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="Selection_Changed">
            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="RowSurface" Background="Transparent" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="RowSurface" Property="Background" Value="{DynamicResource SelectionBackground}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RowSurface" Property="BorderBrush" Value="{DynamicResource SelectionBorder}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate><DataTemplate>
              <Grid Height="72"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="20,0,10,0" VerticalAlignment="Center">
                  <Border Background="{DynamicResource BadgeBackground}" CornerRadius="7" Width="37" Height="37" Margin="0,0,11,0"><TextBlock Text="{Binding Letter}" Foreground="{DynamicResource BadgeText}" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>
                  <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" MaxWidth="135" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/><TextBlock Text="{Binding StartupText}" Style="{StaticResource Caption}" FontSize="11" Margin="0,3,0,0"/></StackPanel>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding SizeText}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding FileSystemText}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="3" Text="{Binding MemoryText}" VerticalAlignment="Center" FontSize="12"/>
                <TextBlock Grid.Column="4" Text="{Binding StatusText}" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Style.Triggers><DataTrigger Binding="{Binding Snapshot.Exists}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Warning}"/></DataTrigger><DataTrigger Binding="{Binding IsMounted}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Success}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
              </Grid>
            </DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <StackPanel x:Name="EmptyState" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10">
            <TextBlock Text="最初の RAM ディスクを追加" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock Text="容量とドライブ文字を選んで、設定を保存しましょう。" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,8,0,0"/>
          </StackPanel>
          <Border Grid.Row="3" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="14,12">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock x:Name="SelectionDetail" Text="ディスクを選択してください" FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="DeleteButton" Content="削除" Click="Delete_Click" FontSize="12" Padding="10,7" Margin="0,0,6,0"/>
                <Button x:Name="EditButton" Content="編集" Click="Edit_Click" FontSize="12" Padding="10,7" Margin="0,0,6,0"/>
                <Button x:Name="OpenButton" Content="開く" Click="Open_Click" FontSize="12" Padding="10,7" Margin="0,0,6,0"/>
                <Button x:Name="MountButton" Content="作成" Click="Mount_Click" Style="{StaticResource PrimaryButton}" FontSize="12" Padding="17,7"/>
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </Border>
      <Border Grid.Row="4" Margin="0,16,0,0" Style="{StaticResource Card}" Padding="16,12">
        <StackPanel><TextBlock Text="アクティビティ" FontSize="12" FontWeight="SemiBold"/><TextBlock x:Name="ActivityText" Text="設定を追加すると、ここからディスクを作成できます。" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/><ProgressBar x:Name="BusyBar" IsIndeterminate="True" Height="3" Margin="0,9,0,0" Visibility="Collapsed" Foreground="{DynamicResource Accent}"/></StackPanel>
      </Border>
      <TextBlock Grid.Row="5" Text="RAM ディスクのデータは、解除・Windows の再起動・電源断で失われます。" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,14,0,0"/>
    </Grid>
    <local:MonitorView x:Name="MonitorPage" Grid.Column="1" Visibility="Collapsed"/>
  </Grid>
</Window>

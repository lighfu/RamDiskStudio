<Window x:Class="RamDisk.App.DiskEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="ディスクの設定" Width="530" Height="760" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
  <Grid Margin="28,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,20"><TextBlock x:Name="HeadingText" Text="ディスクを追加" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="設定を保存してから、一覧でドライブを作成します。" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,6,0,0"/></StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,5,0">
      <TextBlock Text="名前" Margin="0,0,0,6"/><TextBox x:Name="NameInput" MaxLength="60" AutomationProperties.Name="名前"/>
      <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="1.8*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="容量" Margin="0,0,0,6"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><TextBox x:Name="SizeInput" Text="1" AutomationProperties.Name="容量"/><ComboBox x:Name="UnitInput" Grid.Column="1" Margin="8,0,0,0" SelectedIndex="0"><ComboBoxItem Content="GiB"/><ComboBoxItem Content="MiB"/></ComboBox></Grid></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Text="ドライブ文字" Margin="0,0,0,6"/><ComboBox x:Name="LetterInput" AutomationProperties.Name="ドライブ文字"/></StackPanel>
      </Grid>
      <TextBlock x:Name="AvailableText" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,7,0,0"/>
      <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="ファイルシステム" Margin="0,0,0,6"/><ComboBox x:Name="FileSystemInput" AutomationProperties.Name="ファイルシステム"/></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Text="ボリューム名" Margin="0,0,0,6"/><TextBox x:Name="LabelInput" MaxLength="11" AutomationProperties.Name="ボリューム名"/></StackPanel>
      </Grid>
      <TextBlock Text="半角英数字・ハイフン・アンダースコア、11 文字まで" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,7,0,0"/>
      <TextBlock Text="メモリ方式" Margin="0,16,0,6"/>
      <ComboBox x:Name="MemoryInput" SelectedIndex="0" AutomationProperties.Name="メモリ方式"><ComboBoxItem Content="標準メモリ（ImDisk VM）"/><ComboBoxItem Content="物理メモリ固定（awealloc）"/></ComboBox>
      <TextBlock Text="標準方式はページアウトされる場合があります。物理メモリ固定は awealloc ドライバーが必要です。" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,7,0,5"/>
      <TextBlock x:Name="AweStatusText" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Accent}" Margin="0,2,0,5"/>
      <Button x:Name="AweDownloadButton" Content="awealloc の公式配布先を開く" Click="AweDownload_Click" FontSize="11" Padding="10,5" HorizontalAlignment="Left" Margin="0,0,0,5"/>
      <CheckBox x:Name="TempInput" Content="作成時に Temp フォルダーを用意する"/>
      <CheckBox x:Name="StartupInput" Content="このアプリの起動時にディスクを作成する"/>
      <TextBlock Text="Windows 起動時の自動作成ではありません。作成には管理者権限が必要です。内容は毎回空になります。" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource Muted}"/>
      <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Error}" TextWrapping="Wrap" Margin="0,13,0,0" FontSize="12"/>
    </StackPanel></ScrollViewer>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0"><Button Content="キャンセル" IsCancel="True" Margin="0,0,10,0"/><Button Content="設定を保存" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_Click"/></StackPanel>
  </Grid>
</Window>
